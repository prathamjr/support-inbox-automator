# Secrets live here, never in config.json. Fill only what you use.

# Shiprocket API user (Settings -> API). Not needed if fulfillment.mode is "none",
# or if the Shiprocket Fulfillment Automator is installed (its .env is read too).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# The daily message: fill the one matching notify.type in config.json
SLACK_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
